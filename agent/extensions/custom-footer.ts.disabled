/*
 * NOTE: To make editor border color consistent regardless of thinking level,
 * create ~/.pi/agent/themes/uniform-thinking.json with all thinking* colors
 * set to the same value (e.g., "#6272a4" for Dracula comment color).
 * Then select via /settings or add "theme": "uniform-thinking" to settings.json.
 */
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { truncateToWidth, visibleWidth } from "@earendil-works/pi-tui";

export default function (pi: ExtensionAPI) {
  let footerCtx: any;
  let footerTimer: ReturnType<typeof setInterval> | null = null;
  let caffeinateFrame: string | undefined;

  pi.events.on("caffeinate:frame", (frame) => {
    caffeinateFrame = frame as string | undefined;
    refresh();
  });

  function refresh() {
    if (footerCtx) {
      footerCtx.ui.setFooter(buildFooter(footerCtx));
    }
  }

  function getUsageColor(usedPct: number): string {
    if (usedPct <= 50) return "success";
    if (usedPct <= 80) return "warning";
    return "error";
  }

  function getSessionDisplayName(ctx: any): string {
    const name = pi.getSessionName();
    if (name) return name;

    const file = ctx.sessionManager?.getSessionFile?.();
    if (file) {
      const match = file.match(
        /_([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/
      );
      if (match) return match[1].slice(0, 8);
    }

    return "-";
  }

  function getThinkingLevelColor(level: string): string {
    switch (level) {
      case "off": return "thinkingOff";
      case "minimal": return "thinkingMinimal";
      case "low": return "thinkingLow";
      case "medium": return "thinkingMedium";
      case "high": return "thinkingHigh";
      case "xhigh": return "thinkingXhigh";
      default: return "thinkingOff";
    }
  }

  function safeFg(theme: any, color: string, text: string): string {
    try {
      return theme.fg(color, text);
    } catch {
      return theme.fg("dim", text);
    }
  }

  function buildFooter(ctx: any) {
    const cwd = ctx.cwd ?? "-";
    const cwdName = cwd.split("/").pop() || "-";
    const model = ctx.model;
    const modelName = model?.id ?? "-";
    const thinkingLevel = model?.reasoning ? (pi.getThinkingLevel() || "off") : null;

    return (_tui: any, theme: any) => ({
      render(_width: number) {
        const gray = (text: string) => safeFg(theme, "dim", text);

        const sessionName = getSessionDisplayName(ctx);
        const leftParts: string[] = [];
        const rightParts: string[] = [];

        // LEFT: icon, cwd, session, context usage, caffeinate, extension statuses
        leftParts.push(safeFg(theme, "error", "\uf004"));
        leftParts.push(gray(cwdName));
        leftParts.push(gray(sessionName));

        const usage = ctx.getContextUsage();
        let ctxText = "?%";
        let ctxColor = "dim";
        if (usage && usage.contextWindow && usage.contextWindow > 0) {
          const usedPct = Math.min(
            100,
            Math.round((usage.tokens / usage.contextWindow) * 100)
          );
          ctxText = `${usedPct}%`;
          ctxColor = getUsageColor(usedPct);
        }
        leftParts.push(safeFg(theme, ctxColor, ctxText));

        if (caffeinateFrame) {
          leftParts.push(safeFg(theme, "accent", caffeinateFrame));
        }

        const statuses: string[] =
          ctx.footerData?.getExtensionStatuses?.() ?? [];
        for (const s of statuses) {
          leftParts.push(gray(s));
        }

        // RIGHT: model name, thinking level
        rightParts.push(safeFg(theme, "dim", modelName));
        if (thinkingLevel) {
          rightParts.push(safeFg(theme, getThinkingLevelColor(thinkingLevel), thinkingLevel));
        }

        // Push right side to the edge. ANSI-safe: TUI requires every rendered line
        // to stay within the given visible width.
        const leftStr = leftParts.join(" ");
        const rightStr = rightParts.join(" ");
        const rightMax = Math.max(0, _width - 1);
        const safeRight = truncateToWidth(rightStr, rightMax);
        const leftMax = Math.max(0, _width - visibleWidth(safeRight) - 1);
        const safeLeft = truncateToWidth(leftStr, leftMax);
        const padding = Math.max(1, _width - visibleWidth(safeLeft) - visibleWidth(safeRight));

        return [truncateToWidth(safeLeft + " ".repeat(padding) + safeRight, _width)];
      },
      invalidate() {},
    });
  }

  pi.on("session_start", async (_event, ctx) => {
    footerCtx = ctx;
    if (footerTimer) clearInterval(footerTimer);
    refresh();
    footerTimer = setInterval(refresh, 800);
  });

  pi.on("model_select", async (_event, ctx) => {
    footerCtx = ctx;
    refresh();
  });

  pi.on("turn_end", async (_event, ctx) => {
    footerCtx = ctx;
    refresh();
  });

  pi.on("session_shutdown", async () => {
    if (footerTimer) {
      clearInterval(footerTimer);
      footerTimer = null;
    }
    footerCtx = undefined;
    caffeinateFrame = undefined;
  });
}
